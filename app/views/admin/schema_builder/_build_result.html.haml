- if build_result[:error]
  %div.alert.alert-danger.mt-3= build_result[:error]
- if build_result[:info]
  %div.alert.alert-success.mt-3= build_result[:info]
- if build_result[:action]
  %div.alert.mt-3{ class: build_result[:action] == :created ? 'alert-success' : 'alert-info' }
    - if build_result[:action] == :created
      Table créée (ID #{build_result[:table_id]})
    - else
      Table mise à jour (ID #{build_result[:table_id]})
